{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "http" }],
      "destination": "https://emdrtherapybayarea.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/api/og?slug=:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|twitterbot|linkedinbot|whatsapp|slackbot|telegrambot|discordbot).*"
        }
      ]
    },
    { "source": "/api/og", "destination": "/api/og" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
